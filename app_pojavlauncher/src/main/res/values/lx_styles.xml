<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LxLabel">
        <item name="android:textColor">@color/secondary_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
    </style>
    <style name="LxTile" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/lx_tile</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="LxPlay" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/lx_play</item>
        <item name="android:textColor">@color/lx_on_accent</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="LxTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">2dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/secondary_text</item>
        <item name="android:drawableTint">@color/secondary_text</item>
    </style>
    <style name="LxCard">
        <item name="android:background">@drawable/lx_tile</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">104dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:minHeight">92dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">bottom|start</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">3</item>
        <item name="android:ellipsize">end</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
